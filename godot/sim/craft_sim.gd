const Pressure := preload("res://sim/pressure_surface.gd")
var pressure_arc := 0.0   # developed metres around the shell at the chart's origin
var _pressure_weight := 0.0


static func in_pressure(road: int, f: float) -> bool:
	return road == NET_PRESSURE[0] and f >= NET_PRESSURE[1] and f <= NET_PRESSURE[2]


func pressure_depth(f: float) -> float:
	var road: TrackPath = roads[NET_PRESSURE[0]]
	return minf(f - NET_PRESSURE[1], NET_PRESSURE[2] - f) * road.len[NET_PRESSURE[1]]


## The open approach is at 2.4 km altitude. The two lock galleries bring the
## ambient pressure up to the bore's regulated one-atmosphere set point.
func pressure_fill() -> float:
	if pod.off_road or pod.path != NET_PRESSURE[0]:
		return 0.0
	return smoothstep(0.0, Pressure.APRON, pressure_depth(_road_f(pod)))


## Translate the whole tow rig together in its developed tangent plane. Its
## lateral travel becomes real arc length; forces, cable stretch and velocity
## are invariant under the translation. Only outbound airlocks unwind a roll.
func _step_pressure() -> void:
	if pod.off_road or pod.path != NET_PRESSURE[0]:
		pressure_arc = 0.0
		_pressure_weight = 0.0
		return
	var f := _road_f(pod)
	if not in_pressure(pod.path, f):
		pressure_arc = 0.0
		_pressure_weight = 0.0
		return
	var road: TrackPath = roads[pod.path]
	var i: int = NET_PRESSURE[1]
	var nx := road.nx[i]
	var ny := road.ny[i]
	var lat := (pod.x - road.px[i]) * nx + (pod.y - road.py[i]) * ny
	var depth := pressure_depth(f)
	var weight := smoothstep(70.0, Pressure.RECOVERY, depth)
	var shift := lat * smoothstep(70.0, 300.0, depth)
	var half_turn := PI * Pressure.RADIUS
	pressure_arc = wrapf(pressure_arc + shift, -half_turn, half_turn)
	if weight < _pressure_weight:
		pressure_arc *= weight / _pressure_weight
	# The throat becomes a flat receiving lane, even if the pilot stops in
	# the lock and keeps steering across it before choosing to leave.
	pressure_arc = clampf(pressure_arc, -half_turn * weight, half_turn * weight)
	_pressure_weight = weight
	for body: Body in bodies:
		body.x -= nx * shift
		body.y -= ny * shift
var twists: Array = []     # visual full-roll recoveries: [road, start sample, end sample, turns]
var surface_junctions: Array = [] # route junctions plus physical-only overlapping pavement
var _net_cells := {}   # the Network's grid: a NET_CELL square's key -> [[road, first, last sample], ...] (sample runs in it)
var on_ground := false   # the Network: the pod off the roads and down on the open ground (once per spell)
const NET_CELL := 2048.0
const NET_EDGE := 300.0
const LOCK_W := 6.0          # damp arrival motion relative to the moving deck
const LOCK_A := 30.0 * G     # cap relative arrival cushioning, independent of deck acceleration
const JC_REACH := 40.0       # a catch deck reaches this far up for a jump
const CORK_EASE := 0.15   # each corkscrew's roll rate ramps up and down over this share of it

# race and craft state
var battery := 1.0
var armed := false
var mode := "normal"
# Live handling switch, mirroring sim-core.js: inp.handling asks for "speed" or "starfighter";
# STARFIGHTER only engages below P.sfEngageV, then the handling keys blend over P.modeBlendT s.
var hwant := "speed"
var hblend := 0.0
var _hk: Array = []      # the handling keys that blend (not given explicitly in the overrides)
var _h0 := {}
var _h1 := {}
var binder_broken := false
var _tow_u := -1.0          # tow bar's stored energy last substep (-1 = none yet), for the energy audit
var tow_swing := 0.0        # signed articulation of the tow neutral under cornering load
var crash_t := 0.0
var time := 0.0
var lap := 0
