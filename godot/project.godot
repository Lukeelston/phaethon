; Engine configuration file.
config_version=5

[application]

config/name="Phaethon"
config/name.pcvr="Phaethon PC VR"
config/version="0.5.0-experimental"
run/main_scene="res://release/menu.tscn"
run/main_scene.pcvr="res://release/vr_boot.tscn"
run/flush_stdout_on_print.pcvr=true
config/use_custom_user_dir=true
config/custom_user_dir_name="ElstonWorks/Phaethon"
config/custom_user_dir_name.pcvr="ElstonWorks/Phaethon-VR"

[autoload]

ReleasePause="*res://release/pause_overlay.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[xr]

; Desktop remains flat; the separate pcvr export starts OpenXR automatically.
openxr/enabled=false
openxr/enabled.pcvr=true
openxr/reference_space=0
; Request foveation-capable Vulkan swapchains before OpenXR starts. The flight menu sets the live level.
openxr/foveation_level.questflight=2
openxr/foveation_dynamic.questflight=false
openxr/foveation_eye_tracked.questflight=false
openxr/foveation_with_subsampled_images.questflight=false
openxr/extensions/meta/dynamic_resolution.questflight=false
shaders/enabled=true

[rendering]

renderer/rendering_method.questflight="mobile"

[shader_globals]

sky_sun={
"type": "vec3",
"value": Vector3(0.6824, 0.5, 0.5332)
}
sky_sun2={
"type": "vec3",
"value": Vector3(0.7911, 0.4067, 0.4568)
}
sky_sun_glow={
"type": "vec3",
"value": Vector3(1, 0.93, 0.8)
}
sky_sun2_glow={
"type": "vec3",
"value": Vector3(1, 0.6, 0.28)
}
sky_haze={
"type": "vec3",
"value": Vector3(0.58, 0.68, 0.8)
}
sky_haze_scale={
"type": "float",
"value": 1.0
}
sky_wet={
"type": "float",
"value": 0.0
}
sky_snow={
"type": "float",
"value": 0.0
}
world_lift={
"type": "float",
"value": 0.0
}

[editor_plugins]

enabled=PackedStringArray("res://addons/phaethon_export/plugin.cfg")
