; Engine configuration file.
config_version=5

[application]

config/name="Phaethon"
config/version="0.1.0-experimental"
run/main_scene="res://release/menu.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="ElstonWorks/Phaethon"

[autoload]

ReleasePause="*res://release/pause_overlay.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[xr]

; OpenXR stays off for the flat view and tests; launch_vr.ps1 passes --xr-mode on.
openxr/enabled=false
openxr/reference_space=0
shaders/enabled=true
