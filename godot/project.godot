; Engine configuration file.
config_version=5

[application]

config/name="Phaethon"
config/name.pcvr="Phaethon PC VR"
config/version="0.3.3-experimental"
run/main_scene="res://release/menu.tscn"
run/main_scene.pcvr="res://release/vr_boot.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="ElstonWorks/Phaethon"
config/custom_user_dir_name.pcvr="ElstonWorks/Phaethon-VR"

[autoload]

ReleasePause="*res://release/pause_overlay.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[xr]

; Desktop remains flat; the separate pcvr export starts OpenXR automatically.
openxr/enabled=false
openxr/enabled.pcvr=true
openxr/reference_space=0
shaders/enabled=true
